#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk-switch-layout/switch-layout.h>

#define LAYER_FN 1

/ {
    behaviors {
        cli_profile: cli_profile {
            compatible = "zmk-switch-layout,behavior-switch-layout-mode";
            #binding-cells = <1>;
            // Profile indices are persisted: 0 = Codex, 1 = Claude.
            layout-count = <2>;
            default-layout = <0>;
        };

        change_model: change_model {
            compatible = "zmk-switch-layout,behavior-switch-layout-key";
            #binding-cells = <0>;
            bindings = <&codex_change_model>, <&kp LA(P)>;
        };
    };

    macros {
        codex_change_model: codex_change_model {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp SLASH &kp M &kp O &kp D &kp E &kp L>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp RALT         &kp LS(TAB)            &kp ESC
                &mo LAYER_FN     &change_model          &kp ENTER
            >;

            sensor-bindings = <&inc_dec_kp UP_ARROW DOWN_ARROW>;
        };

        fn_layer {
            bindings = <
                &bt BT_CLR_ALL   &cli_profile ZMK_SWITCH_LAYOUT_NEXT   &kp LC(BACKSPACE)
                &trans           &kp LC(LEFT)   &kp LC(RIGHT)
            >;

            sensor-bindings = <&inc_dec_kp LEFT RIGHT>;
        };
    };
};
